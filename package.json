{
  "name": "remote-fileshare",
  "version": "1.1.1",
  "description": "Remote file sharing between your browser and a server: upload, download, preview, folder tar.gz, resumable. One command, zero dependencies, built for remote AI agents. 远程文件共享：一行 npx / uvx 启动，在浏览器和远程服务器之间上传、下载、预览、打包文件；带密码、断点续传、零依赖，专为远程 AI agent 设计",
  "main": "remote-fileshare.js",
  "bin": {
    "remote-fileshare": "remote-fileshare.js"
  },
  "scripts": {
    "start": "node remote-fileshare.js",
    "test": "node --test",
    "test:python": "FILESHARE_IMPL=python node --test",
    "sync-ui": "node scripts/sync-ui.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "remote-fileshare.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chao5go/remote-fileshare.git"
  },
  "homepage": "https://github.com/chao5go/remote-fileshare#readme",
  "bugs": "https://github.com/chao5go/remote-fileshare/issues",
  "keywords": [
    "remote",
    "file-sharing",
    "file-transfer",
    "file-server",
    "upload",
    "download",
    "http-server",
    "zero-dependency",
    "self-hosted",
    "ai-agent",
    "claude-code",
    "npx",
    "uvx"
  ],
  "author": "chao5go",
