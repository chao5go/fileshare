{
  "name": "remote-fileshare",
  "version": "1.2.1",
  "description": "Send screenshots and files from your browser to Claude Code, Codex CLI and other AI agents running on a remote Linux server, and download what they produce. One command, password, HTTPS, zero dependencies. 远程文件共享：在远程 Linux 机器上用 Claude Code、Codex CLI 写代码时，从浏览器把截图、文件传给 AI agent，并把结果下载回本地；一行 npx / uvx 启动，带密码、HTTPS、零依赖",
  "main": "remote-fileshare.js",
  "bin": {
    "remote-fileshare": "remote-fileshare.js"
  },
  "scripts": {
    "start": "node remote-fileshare.js",
    "test": "node --test",
    "test:python": "FILESHARE_IMPL=python node --test",
    "sync-ui": "node scripts/sync-ui.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "remote-fileshare.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chao5go/remote-fileshare.git"
  },
  "homepage": "https://github.com/chao5go/remote-fileshare#readme",
  "bugs": "https://github.com/chao5go/remote-fileshare/issues",
  "keywords": [
    "remote",
    "file-sharing",
    "file-transfer",
    "file-server",
    "upload",
    "screenshot",
    "ai-agent",
    "claude-code",
    "codex",
    "ssh",
    "zero-dependency",
    "self-hosted",
    "npx",
    "uvx"
  ],
  "author": "chao5go",
  "license": "MIT"
}
