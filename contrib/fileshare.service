# systemd 服务示例：开机自启、崩溃自动重启。
# 安装：
#   sudo cp contrib/fileshare.service /etc/systemd/system/
#   按需修改下面的路径、用户和密码
#   sudo systemctl daemon-reload && sudo systemctl enable --now fileshare
# 查看日志：journalctl -u fileshare -f

[Unit]
Description=fileshare web file sharing server
After=network-online.target
Wants=network-online.target

[Service]
User=root
ExecStart=/usr/bin/node /opt/fileshare/fileshare.js /root/share
Environment=PORT=8001
# 不设置 PASS 时，密码随机生成并保存在该用户的 ~/.config/fileshare/password
# Environment=PASS=change-me
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
